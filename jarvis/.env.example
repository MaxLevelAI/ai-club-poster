# Copy to .env.local for local runs. On Vercel, add these under Settings > Environment Variables.
# Everything here stays on the server. Never put these in client code.

# GitHub fine-grained token for MaxLevelAI/ai-club-poster
# Permissions: Actions (RW), Contents (R), Issues (RW), Variables (RW), Metadata (R)
GITHUB_TOKEN=
GITHUB_REPO=MaxLevelAI/ai-club-poster

# Instagram (same values as the GitHub secrets)
IG_PAGE_TOKEN=
IG_USER_ID=17841426927209902

# Password that unlocks the controls (approve, kill switch, voice...)
CONTROL_PASSWORD=

# Voice
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Optional: any ElevenLabs voice id. Default is a premade British male voice ("George").
ELEVENLABS_VOICE_ID=
